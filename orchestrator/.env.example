PORT=8787
ALLOWED_ORIGIN=http://localhost:3200
# Local CRE simulation with a real Ethereum Sepolia broadcast:
MANDATE_RUNNER=/absolute/path/to/repo/orchestrator/bin/cre-local-simulation-runner
MANDATE_RUNNER_TIMEOUT_MS=120000
CRE_CLI=/absolute/path/to/cre
# Directory containing Bun for TypeScript workflow compilation.
CRE_TOOL_PATH=/absolute/path/to/bun-directory
CRE_PROJECT_DIR=/absolute/path/to/repo/workflow
CRE_WORKFLOW_DIR=market-maker-auth
CRE_TARGET=staging-settings
MANDATE_GUARD_ADDRESS=0xfadc3165abeb127a0815d5ea4e2862ed430e1f70
MANDATE_ROUTER_ADDRESS=0x47a875f39ba4b0d0beaa928bb071d4b4da0b4092
MANDATE_STRATEGY_MAKER=0x24f93609de41a839f411d18f3ee242c5089caad7
MANDATE_STRATEGY_CATALOG={"featured-tight-market":{"name":"Tight Market","provider":"PinTool Strategies","strategyHash":"0x23b5f02fe3e0bd1079059341d55d45d0cbcb8f992ebf742d82962ec40ff3af4f"},"featured-defensive-market":{"name":"Defensive Market","provider":"PinTool Strategies","strategyHash":"0xf0f27135496be85b02d71ce2b3cb83c4d730100b72ec158a6e782d8bcdd3732a"}}
MANDATE_MARKET_SNAPSHOT={"midPrice":"2500","volatilityBps":120,"balance0":"4000000000000000","balance1":"10000000","decimals0":18,"decimals1":6}
# Optional: reread this public observation before each workflow execution.
# MANDATE_MARKET_SNAPSHOT_FILE=/absolute/path/to/current-market-snapshot.json
MANDATE_CHAIN_ID=11155111
MANDATE_NETWORK_NAME=Ethereum Sepolia
MANDATE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MANDATE_EXPLORER_URL=https://sepolia.etherscan.io
MANDATE_STATE_DIR=.state/mandates

# Replace the local runner above with these values after a workflow is deployed:
# MANDATE_RUNNER=/absolute/path/to/repo/orchestrator/bin/cre-mandate-runner
# CRE_GATEWAY_URL=https://01.gateway.zone-a.cre.chain.link
# CRE_WORKFLOW_ID=replace-with-64-character-workflow-id
# CRE_HTTP_TRIGGER_PRIVATE_KEY=replace-with-authorized-private-key

# Alternative adapter for a team-operated confidential execution service:
# MANDATE_RUNNER=/absolute/path/to/orchestrator/bin/confidential-http-runner
# CONFIDENTIAL_EXECUTION_URL=https://execution.example/v1/run
# CONFIDENTIAL_EXECUTION_TOKEN=replace-with-a-service-token
# CONFIDENTIAL_EXECUTION_TIMEOUT_MS=120000
