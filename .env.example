# PinTool user frontend (Next.js) — public env vars.
# All are NEXT_PUBLIC_* → baked into the client bundle at BUILD time, so they
# must be set in Vercel BEFORE/at build (Production + Preview), not just runtime.

# NestJS backend base URL (currently on Railway).
NEXT_PUBLIC_PINTOOL_API_URL=https://pintool-backend-production.up.railway.app

# Supabase project (client-side reads with the anon key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Solana RPC the app (wallet adapter + balance/transfer flows) talks to.
# Defaults to mainnet-beta public RPC when unset; use a paid RPC in production.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
