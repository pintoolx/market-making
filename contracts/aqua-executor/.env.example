# Base Sepolia (chainId 84532). The `local` network always uses anvil's dev keys and ignores these.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Maker: deploys the contracts + mock tokens, then approves / ships / docks. Needs Base Sepolia ETH.
MAKER_PK=0x
# Taker: approves the router and swaps. `npm run deploy` tops it up with a little ETH from the maker.
TAKER_PK=0x
# LOCAL_RPC_URL=http://127.0.0.1:8545
# Read-only Base mainnet price feeds; optional comma-separated failover endpoints.
# BASE_PRICE_RPC_URLS=https://base-rpc.publicnode.com,https://mainnet.base.org
