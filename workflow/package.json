{
  "name": "@pintool/workflow",
  "version": "0.1.0",
  "private": true,
  "description": "Chainlink CRE confidential workflow: intersects the Provider strategy and the Maker limits inside a TEE and emits a GuardReportV1 for the Aqua Guard.",
  "scripts": {
    "test": "bun test src market-maker-auth",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "simulate": "cre workflow simulate market-maker-auth --non-interactive --trigger-index 0 --target staging-settings",
    "simulate:http": "cre workflow simulate market-maker-auth --non-interactive --trigger-index 1 --http-payload market-maker-auth/http-request.example.json --target staging-settings",
    "check:leak": "bash scripts/check-no-leak.sh"
  },
  "dependencies": {
    "@chainlink/cre-sdk": "1.20.1",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.6",
    "@noble/hashes": "1.8.0",
    "viem": "2.34.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.2.16",
    "typescript": "5.9.3"
  }
}
